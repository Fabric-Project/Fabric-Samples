          {
            "payload" : {
              "base" : {
                "id" : "7A191BCA-88CE-44F2-83A7-C41CC66D9716",
                "name" : "3D Landmarks",
                "kind" : "Outlet",
                "published" : false,
                "portDescription" : "All 33 BlazePose landmarks (same order as Landmarks) as the model's metric, view-independent world shape, placed in Fabric's scene space so the default perspective camera sees it on top of the image: it keeps its metric size and only its position is fit to the image landmarks (weighted by each landmark's visibility), so a body that appears larger sits nearer the camera (larger z); a body 1 m away sits on the image plane. A true 3D shape, so x\/y match Landmarks only approximately. Directly comparable against MediaPipe Face\/Hand Landmarks' own 3D Landmarks output, so all three can be composited in one 3D scene — not physically metric, just a consistent shared space. Empty if nothing was detected."
              },
              "isProxyPort" : false,
              "isParameterPort" : false,
              "type" : "Array of Vector 3"
            },
            "name" : "outputLandmarksScene"
          },
